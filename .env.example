# ============================================================
# Competition Platform — Environment Variables
# ------------------------------------------------------------
# Copy to .env, then `docker-compose up --build -d`.
# Values below are LOCAL DEV DEFAULTS — the stack boots as-is.
# >>> Change EVERY secret before any shared/production deploy. <<<
# NEVER commit your real .env.
# ============================================================

# --- Database (MySQL) ---
# MYSQL_USER/PASSWORD must match MYSQL_ROOT_PASSWORD for the default root user.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=root
MYSQL_PASSWORD=root

# --- Message broker (RabbitMQ) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Object storage (MinIO / S3) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# --- Auth ---
# Any non-empty string works locally; use a 256-bit hex secret in production.
JWT_SECRET=dev_local_secret_change_me_in_production_0123456789abcdef
# Independent first-party service JWT secret. Never reuse the user JWT secret.
SERVICE_JWT_SECRET=dev_internal_secret_change_before_deploy_abcdef0123456789
# Comma-separated origins allowed to call the API (browser CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public base URL of the gateway, used to build OAuth callback URLs.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# --- OAuth providers (optional — only for GitHub/Google social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP mail (optional — only for password reset + email notifications) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# Browser API origin is baked into the frontend image at build time.
VITE_API_BASE_URL=http://localhost:8080

# --- Nacos 3 (internal discovery, client/admin/console authentication enabled) ---
# Generate an independent signing key with: openssl rand -base64 32
# Supply real values; Compose refuses to start with missing authentication secrets.
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=competition-platform-node
NACOS_AUTH_IDENTITY_VALUE=
# Existing volumes retain the nacos admin password. Bootstrap never resets it.
NACOS_ADMIN_PASSWORD=
# Dedicated account has public namespace read/write only; no administrator role.
NACOS_USERNAME=competition-platform
NACOS_PASSWORD=

# Public URLs used by email/OAuth links and file URLs; set deployed hostnames.
FRONTEND_BASE_URL=http://localhost:3000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# SMTP provider; connect/read/write timeouts are 10 seconds.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Maintained S3-compatible service for public deployments. Local MinIO CE is
# archived and built only for compatibility checks; provider credentials may
# differ from the local storage administrator credentials above.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=
