# ============================================================
# Competition Platform — Environment Variables
# ------------------------------------------------------------
# Copy to .env, then `docker-compose up --build -d`.
# Values below are LOCAL DEV DEFAULTS — the stack boots as-is.
# >>> Change EVERY secret before any shared/production deploy. <<<
# NEVER commit your real .env.
# ============================================================

# --- Database (MySQL) ---
# MYSQL_USER/PASSWORD must match MYSQL_ROOT_PASSWORD for the default root user.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=root
MYSQL_PASSWORD=root

# --- Message broker (RabbitMQ) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Object storage (MinIO / S3) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# --- Auth ---
# Any non-empty string works locally; use a 256-bit hex secret in production.
JWT_SECRET=dev_local_secret_change_me_in_production_0123456789abcdef
# Comma-separated origins allowed to call the API (browser CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public base URL of the gateway, used to build OAuth callback URLs.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# --- OAuth providers (optional — only for GitHub/Google social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP mail (optional — only for password reset + email notifications) ---
MAIL_USERNAME=
MAIL_PASSWORD=
